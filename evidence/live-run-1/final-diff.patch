+++ b/orders/validation.py
@@ -26,6 +26,23 @@ def required_margin(order: Order) -> Decimal:
     return order.qty * order.price * inst.margin_rate
 
 
+def _breaches_position_limit(order: Order, account: Account) -> bool:
+    """True only if the order increases exposure AND ends above the limit.
+
+    Missing limit means no limit; missing position means zero. Reducing or
+    closing orders never breach, even if the account is already over the limit.
+    """
+    limit = account.position_limits.get(order.symbol)
+    if limit is None:
+        return False
+    current = account.positions.get(order.symbol, Decimal(0))
+    new = current + signed_qty(order)
+    if current * new < 0:
+        # Flip through zero opens a brand-new position; it must fit the limit.
+        return abs(new) > limit
+    return abs(new) > abs(current) and abs(new) > limit
+
+
 def validate_order(order: Order, account: Account) -> ValidationResult:
     inst = INSTRUMENTS.get(order.symbol)
     if inst is None:
@@ -38,4 +55,6 @@ def validate_order(order: Order, account: Account) -> ValidationResult:
         return ValidationResult.reject(Reason.BAD_PRICE_TICK)
     if required_margin(order) > account.free_margin:
         return ValidationResult.reject(Reason.INSUFFICIENT_MARGIN)
+    if _breaches_position_limit(order, account):
+        return ValidationResult.reject(Reason.POSITION_LIMIT)
     return ValidationResult.ok()
