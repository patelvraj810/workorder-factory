+def _lim(side, qty, pos=None, limit="10", sym="XAUUSD", limits=None):
+    positions = {} if pos is None else {"XAUUSD": D(pos)}
+    if limits is None:
+        limits = {sym: D(limit)}
+    a = Account("A1", D("1000000"), positions, position_limits=limits)
+    return validate_order(Order("XAUUSD", side, D(qty), D("2400.00")), a)
+
+
+def test_limit_flat_buy_and_sell_at_and_over():
+    assert _lim(Side.BUY, "10").accepted
+    assert _lim(Side.SELL, "10").accepted
+    assert _lim(Side.BUY, "10.01").reason is Reason.POSITION_LIMIT
+    assert _lim(Side.SELL, "10.01").reason is Reason.POSITION_LIMIT
+
+
+def test_limit_long_and_short_increase():
+    assert _lim(Side.BUY, "4", pos="6").accepted
+    assert _lim(Side.BUY, "4.01", pos="6").reason is Reason.POSITION_LIMIT
+    assert _lim(Side.SELL, "4", pos="-6").accepted
+    assert _lim(Side.SELL, "4.01", pos="-6").reason is Reason.POSITION_LIMIT
+
+
+def test_limit_reducing_while_over_limit_allowed():
+    assert _lim(Side.SELL, "1", pos="300", limit="100").accepted
+    assert _lim(Side.BUY, "1", pos="-300", limit="100").accepted
+    assert _lim(Side.SELL, "300", pos="300", limit="100").accepted
+    # increasing while already over limit is rejected
+    assert _lim(Side.BUY, "1", pos="300", limit="100").reason is Reason.POSITION_LIMIT
+
+
+def test_limit_flip_across_zero():
+    assert _lim(Side.SELL, "12", pos="5").accepted  # -7, within 10
+    assert _lim(Side.BUY, "12", pos="-5").accepted  # +7
+    assert _lim(Side.SELL, "16", pos="5").reason is Reason.POSITION_LIMIT  # -11
+    assert _lim(Side.BUY, "16", pos="-5").reason is Reason.POSITION_LIMIT  # +11
+
+
+def test_limit_flip_into_over_limit_rejected():
+    # a flip opens a new position that must fit the limit, even if abs shrinks
+    assert _lim(Side.SELL, "500", pos="300", limit="100").reason is Reason.POSITION_LIMIT
+    assert _lim(Side.SELL, "600", pos="300", limit="100").reason is Reason.POSITION_LIMIT
+    assert _lim(Side.BUY, "500", pos="-300", limit="100").reason is Reason.POSITION_LIMIT
+    assert _lim(Side.BUY, "600", pos="-300", limit="100").reason is Reason.POSITION_LIMIT
+
+
+def test_limit_flip_landing_exactly_on_limit_allowed():
+    assert _lim(Side.SELL, "15", pos="5").accepted  # -10
+    assert _lim(Side.BUY, "15", pos="-5").accepted  # +10
+    assert _lim(Side.SELL, "400", pos="300", limit="100").accepted  # -100
+    assert _lim(Side.SELL, "300", pos="300", limit="100").accepted  # close
+
+
+def test_no_limit_or_other_symbol_limit():
+    assert _lim(Side.BUY, "500", limits={}).accepted
+    assert _lim(Side.BUY, "500", limits={"US500": D("1")}).accepted
+
+
+def test_limit_does_not_mutate():
+    a = Account("A1", D("1000000"), {"XAUUSD": D("5")}, position_limits={"XAUUSD": D("10")})
+    o = Order("XAUUSD", Side.BUY, D("20"), D("2400.00"))
+    validate_order(o, a)
+    assert a == Account("A1", D("1000000"), {"XAUUSD": D("5")}, position_limits={"XAUUSD": D("10")})
+    assert o == Order("XAUUSD", Side.BUY, D("20"), D("2400.00"))
+
+
