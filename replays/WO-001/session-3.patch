 def _breaches_position_limit(order: Order, account: Account) -> bool:
+    """True only if the order OPENS exposure beyond the limit.
+
+    - Reducing or closing a position is never blocked, even when the account is already
+      over its limit (e.g. after the limit was lowered).
+    - A flip through zero closes the old position and opens a new one on the other side:
+      the new side must fit within the limit (business rule from the work-order owner).
+    """
     limit = account.position_limits.get(order.symbol)
     if limit is None:
         return False
     current = account.positions.get(order.symbol, Decimal("0"))
-    return abs(current) + order.qty > limit
+    new_position = current + signed_qty(order)
+    crosses_zero = current != 0 and new_position != 0 and (current > 0) != (new_position > 0)
+    if crosses_zero:
+        return abs(new_position) > limit
+    if abs(new_position) <= abs(current):
+        return False
+    return abs(new_position) > limit
 
 
 def validate_order(order: Order, account: Account) -> ValidationResult:
