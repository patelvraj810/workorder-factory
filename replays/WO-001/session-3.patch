+def test_buy_reducing_short_never_blocked():
+    r = validate_order(Order("XAUUSD", Side.BUY, D("5.00"), D("2400.00")), limited("-30", "20"))
+    assert r.accepted
+
+
+def test_sell_increasing_short_beyond_limit_rejected():
+    r = validate_order(Order("XAUUSD", Side.SELL, D("15.00"), D("2400.00")), limited("-10", "20"))
+    assert r.reason is Reason.POSITION_LIMIT
